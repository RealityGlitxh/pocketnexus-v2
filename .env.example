# PocketNexus 2.0 — environment template
#
# Copy to apps/web/.env.local for local development. Never commit real values.
#
# ONLY browser-safe values belong here. Anything prefixed VITE_ is bundled
# into public JavaScript and visible to every visitor.
#
# NEVER put any of these in a VITE_ variable or in this repo:
#   - Supabase service_role / secret keys (sb_secret_…)
#   - Database passwords or connection strings
#   - Third-party API keys (OpenAI, etc.)
# Those belong in Supabase Edge Function secrets or the CI secret store.

# Which environment this build targets: development | staging | production
VITE_APP_ENV=development

# Supabase DEVELOPMENT project (must NOT be the legacy production project
# cdmzrsvwztndqfwzsumo used by beta.pocketnexus.app).
VITE_SUPABASE_URL=
# Publishable (anon) key only — sb_publishable_… or a legacy anon JWT.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public site URL used for auth redirects (password reset, email confirm)
VITE_SITE_URL=http://localhost:5173
