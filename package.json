{
  "name": "pocketnexus-v2",
  "private": true,
  "version": "0.0.0",
  "description": "PocketNexus 2.0 — an unofficial, independent companion platform for Pokémon TCG Pocket.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pocketnexus/web dev",
    "build": "pnpm --filter @pocketnexus/web build",
    "preview": "pnpm --filter @pocketnexus/web preview",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --parallel test",
    "test:e2e": "pnpm --filter @pocketnexus/web test:e2e",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "db:test": "bash supabase/tests/run-local-postgres.sh",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:bundle && pnpm check:secrets"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
